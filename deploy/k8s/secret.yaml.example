# EXAMPLE ONLY — do not commit with real values.
# Copy to secret.yaml, fill in base64-encoded values, then:
#   kubectl apply -f deploy/k8s/secret.yaml
#
# Encode a value:  echo -n 'myvalue' | base64
apiVersion: v1
kind: Secret
metadata:
  name: disapyr-secret
  namespace: disapyr
type: Opaque
data:
  # postgres://disapyr:<POSTGRES_PASSWORD>@postgres:5432/disapyr?sslmode=disable
  DATABASE_URL: <base64-encoded-connection-string>
  POSTGRES_PASSWORD: <base64-encoded-postgres-password>
  ADMIN_USER: <base64-encoded-admin-username>
  ADMIN_PASSWORD: <base64-encoded-admin-password>
