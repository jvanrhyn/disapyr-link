# PostgreSQL credentials (used by docker-compose for the postgres service)
POSTGRES_USER=disapyr
POSTGRES_PASSWORD=changemelater
POSTGRES_DB=disapyr

DATABASE_URL=postgres://disapyr:${POSTGRES_PASSWORD}@localhost:5432/disapyr?sslmode=disable
PORT=8080
BASE_URL=http://localhost:8080
MAX_SECRET_BYTES=10485760
LOG_LEVEL=info

# Rate limiting (requests per minute per IP, 0 = disabled)
RATE_LIMIT_CREATE_PER_MIN=10
RATE_LIMIT_REVEAL_PER_MIN=20
# Admin /health endpoints — low default prevents brute-force on Basic Auth credentials
RATE_LIMIT_HEALTH_PER_MIN=5

# Set to "true" only when the app runs behind a trusted reverse proxy (nginx, Caddy, OrbStack, etc.)
# that sets the X-Forwarded-For header. Leave false/unset for direct exposure.
TRUST_PROXY=false
# Number of trusted proxies in front of the application to skip when parsing X-Forwarded-For (default is 1)
TRUSTED_PROXIES_COUNT=1

# Minimum log level written to the app_logs database table.
# Valid values: debug, info, warn, error. Default: warn
# (INFO would write every HTTP request to the DB — use warn or error in production)
LOG_DB_MIN_LEVEL=warn

# Admin credentials for /health (health status + log browser).
# Both must be set to enable the admin interface. Leave empty to disable.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

